[Unit]
Description=OID Compressor Copilot — Streamlit
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/aws_compressor
ExecStart=/home/ec2-user/.local/bin/uv run streamlit run app/streamlit_app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=on-failure
RestartSec=5
Environment=HOME=/home/ec2-user

[Install]
WantedBy=multi-user.target
