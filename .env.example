# OID Compressor Copilot — environment variables (prefix OID_)
# Copy to .env and fill in real values. Never commit .env.

OID_ENV=local
OID_AWS_REGION=us-east-1
OID_S3_BUCKET=oid-compressor-YOURNAME
OID_RAW_PREFIX=raw/
OID_DB_PATH=data/oid.duckdb
OID_TRACES_DB_PATH=data/traces.duckdb
OID_LLM_BACKEND=bedrock   # "bedrock" (IAM auth) or "openai" (API key)
OID_LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Only needed when OID_LLM_BACKEND=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://your-endpoint/v1
OID_AGENT_MAX_STEPS=5
OID_SQL_ROW_LIMIT=500
OID_ZSCORE_THRESHOLD=4.0
OID_IFOREST_CONTAMINATION=0.01
OID_NORMAL_PERIOD_START=2023-08-01
OID_NORMAL_PERIOD_END=2023-10-01

# Cognite SDK (for extraction only, laptop)
OID_COGNITE_PROJECT=publicdata
OID_COGNITE_CLIENT_ID=your-client-id
OID_COGNITE_CLIENT_SECRET=your-client-secret
OID_COGNITE_TENANT_ID=your-tenant-id
OID_COGNITE_CDF_CLUSTER=api
